<ServerManagerConfiguration>

  <ProxyGroup name="sources">
    <SourceProxy name="ViennaPSGeometrySource"
                 class="vtkViennaPSGeometrySource"
                 label="ViennaPS Geometry">

      <InputProperty name="Input"
                     command="SetInputConnection"
                     port_index="0">
        <ProxyGroupDomain name="groups">
          <Group name="sources"/>
          <Group name="filters"/>
        </ProxyGroupDomain>
        <DataTypeDomain name="input_type">
          <DataType value="vtkPolyData"/>
          <DataType value="vtkUnstructuredGrid"/>
        </DataTypeDomain>
        <Hints>
          <Optional/>
        </Hints>
        <Documentation>
          Optional VTK mesh input to create ViennaPS domain from.
          Connect a ParaView source (Box, Cylinder, etc.) to create
          a domain from its geometry.
        </Documentation>
      </InputProperty>

      <IntVectorProperty name="Dummy"
                         command="SetDummy"
                         panel_widget="pqViennaPSWidget"
                         panel_visibility="default"
                         label="">
      <BooleanDomain name="bool"/>
      </IntVectorProperty>

      <StringVectorProperty name="State"
                            command="SetState"
                            number_of_elements="1"
                            default_values=""
                            panel_visibility="never">
        <Documentation>
          Serialized panel state (model, domain settings, and all model
          parameters) so ParaView Save State / Load State round-trips the
          dynamically generated parameters. Not shown in the panel.
        </Documentation>
      </StringVectorProperty>

      <Hints>
        <ShowInMenu category="ViennaPS" />
      </Hints>
    </SourceProxy>
  </ProxyGroup>

  <ProxyGroup name="filters">
    <SourceProxy name="ViennaPSProcessFilter"
                 class="vtkViennaPSProcessFilter"
                 label="ViennaPS Process">

      <InputProperty name="Input"
                     command="SetInputConnection">
        <ProxyGroupDomain name="groups">
          <Group name="sources"/>
          <Group name="filters"/>
        </ProxyGroupDomain>
        <Documentation>Input domain object from ViennaPS Geometry Source</Documentation>
      </InputProperty>

      <IntVectorProperty name="Dummy"
                         command="SetDummy"
                         panel_widget="pqViennaPSWidget"
                         panel_visibility="default"
                         label="">
      <BooleanDomain name="bool"/>
      </IntVectorProperty>

      <StringVectorProperty name="State"
                            command="SetState"
                            number_of_elements="1"
                            default_values=""
                            panel_visibility="never">
        <Documentation>
          Serialized panel state (model, domain settings, and all model
          parameters) so ParaView Save State / Load State round-trips the
          dynamically generated parameters. Not shown in the panel.
        </Documentation>
      </StringVectorProperty>

      <Hints>
        <ShowInMenu category="ViennaPS" />
      </Hints>
    </SourceProxy>
  </ProxyGroup>

</ServerManagerConfiguration>
